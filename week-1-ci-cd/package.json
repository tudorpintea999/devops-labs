{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "Simple Todo API for DevOps learning",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/**/*.js",
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.x.x",
    "jest": "^29.x.x",
    "nodemon": "^3.0.1",
    "supertest": "^6.x.x"
  }
}